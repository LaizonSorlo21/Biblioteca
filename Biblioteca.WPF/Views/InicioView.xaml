<UserControl x:Class="Biblioteca.WPF.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Sistema de Biblioteca" Style="{StaticResource Titulo}" />
        <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12"
                   Text="Aplicación académica de gestión de biblioteca con arquitectura en capas (Entidades, Datos, Negocio y WPF) sobre SQL Server." />
        <TextBlock FontSize="14" LineHeight="26">
            <Run FontWeight="SemiBold" Text="Libros" /><Run Text=": mantenimiento del catálogo." /><LineBreak />
            <Run FontWeight="SemiBold" Text="Socios" /><Run Text=": mantenimiento de socios." /><LineBreak />
            <Run FontWeight="SemiBold" Text="Préstamos" /><Run Text=": registro de préstamos (máximo 3 libros pendientes por socio)." /><LineBreak />
            <Run FontWeight="SemiBold" Text="Devoluciones" /><Run Text=": devolución de libros y cálculo de multa (S/ 1.50 por día de retraso)." /><LineBreak />
            <Run FontWeight="SemiBold" Text="Reporte" /><Run Text=": préstamos por rango de fechas." />
        </TextBlock>
    </StackPanel>
</UserControl>
